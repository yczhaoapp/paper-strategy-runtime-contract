{
  "$id": "urn:psrc:schema/fill.schema.json?contract=1.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "client_order_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
      "title": "Client Order Id",
      "type": "string"
    },
    "fee": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Fee"
    },
    "fill_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
      "title": "Fill Id",
      "type": "string"
    },
    "instrument_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
      "title": "Instrument Id",
      "type": "string"
    },
    "price": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Price"
    },
    "quantity": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Quantity"
    },
    "side": {
      "enum": [
        "buy",
        "sell"
      ],
      "title": "Side",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "client_order_id",
    "fee",
    "fill_id",
    "instrument_id",
    "price",
    "quantity",
    "side",
    "timestamp"
  ],
  "title": "Fill",
  "type": "object"
}
