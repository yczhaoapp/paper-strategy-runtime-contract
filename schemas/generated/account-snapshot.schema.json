{
  "$defs": {
    "OpenOrder": {
      "additionalProperties": false,
      "properties": {
        "client_order_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Client Order Id",
          "type": "string"
        },
        "instrument_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Instrument Id",
          "type": "string"
        },
        "limit_price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Price"
        },
        "order_type": {
          "enum": [
            "limit",
            "market",
            "target"
          ],
          "title": "Order Type",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "side": {
          "anyOf": [
            {
              "enum": [
                "buy",
                "sell"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Side"
        },
        "status": {
          "default": "accepted",
          "enum": [
            "accepted",
            "partially_filled",
            "replaced"
          ],
          "title": "Status",
          "type": "string"
        },
        "target_quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Quantity"
        }
      },
      "required": [
        "client_order_id",
        "instrument_id",
        "order_type"
      ],
      "title": "OpenOrder",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "average_price": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Average Price"
        },
        "instrument_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "title": "Instrument Id",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "realized_pnl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Realized Pnl"
        },
        "unrealized_pnl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Unrealized Pnl"
        }
      },
      "required": [
        "average_price",
        "instrument_id",
        "quantity"
      ],
      "title": "Position",
      "type": "object"
    }
  },
  "$id": "urn:psrc:schema/account-snapshot.schema.json?contract=1.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_currency": {
      "default": "USD",
      "title": "Base Currency",
      "type": "string"
    },
    "cash": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Cash"
    },
    "equity": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Equity"
    },
    "open_orders": {
      "default": [],
      "items": {
        "$ref": "#/$defs/OpenOrder"
      },
      "title": "Open Orders",
      "type": "array"
    },
    "positions": {
      "items": {
        "$ref": "#/$defs/Position"
      },
      "title": "Positions",
      "type": "array"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "cash",
    "equity",
    "positions",
    "timestamp"
  ],
  "title": "AccountSnapshot",
  "type": "object"
}
