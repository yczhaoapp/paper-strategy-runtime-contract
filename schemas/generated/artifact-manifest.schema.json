{
  "$defs": {
    "ArtifactFile": {
      "additionalProperties": false,
      "properties": {
        "logical_name": {
          "title": "Logical Name",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "logical_name",
        "media_type",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactFile",
      "type": "object"
    }
  },
  "$id": "urn:psrc:schema/artifact-manifest.schema.json?contract=1.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_kind": {
      "enum": [
        "model",
        "not_applicable",
        "policy",
        "state"
      ],
      "title": "Artifact Kind",
      "type": "string"
    },
    "contract_version": {
      "default": "1.3.0",
      "title": "Contract Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ArtifactFile"
      },
      "title": "Files",
      "type": "array"
    },
    "framework": {
      "title": "Framework",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Metadata",
      "type": "object"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "strategy_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
      "title": "Strategy Id",
      "type": "string"
    },
    "strategy_version": {
      "title": "Strategy Version",
      "type": "string"
    },
    "training_dataset_id": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Training Dataset Id"
    },
    "training_request_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Training Request Sha256"
    }
  },
  "required": [
    "artifact_id",
    "artifact_kind",
    "created_at",
    "files",
    "framework",
    "strategy_id",
    "strategy_version"
  ],
  "title": "ArtifactManifest",
  "type": "object"
}
