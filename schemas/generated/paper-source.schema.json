{
  "$id": "urn:psrc:schema/paper-source.schema.json?contract=1.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable public paper bytes used by one or more strategy bindings.",
  "properties": {
    "authors": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Authors",
      "type": "array"
    },
    "source_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$",
      "title": "Source Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "source_url": {
      "title": "Source Url",
      "type": "string"
    },
    "title": {
      "minLength": 5,
      "title": "Title",
      "type": "string"
    },
    "version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "authors",
    "source_id",
    "source_sha256",
    "source_url",
    "title"
  ],
  "title": "PaperSource",
  "type": "object"
}
